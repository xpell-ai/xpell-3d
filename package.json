{
  "name": "@xpell/3d",
  "version": "2.0.8",
  "description": "Xpell UI 3D JS Framework",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "docs": "typedoc --options ./typedoc.json --tsconfig ./",
    "publish-alpha-next": "pnpm version prerelease --preid=alpha  && pnpm publish --tag alpha"
  },
  "xpell": {
    "_tests": [
      {
        "_id": "xpell-3d.script.build",
        "_title": "@xpell/3d build verification",
        "_owner": "@xpell/3d",
        "_suite": "xpell-3d.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Build-only verification because no package test script exists.",
        "_profiles": [
          "xpell-3d.package"
        ],
        "_tags": [
          "package",
          "build"
        ],
        "_entry": {
          "_type": "build",
          "_script": "build"
        }
      },
      {
        "_id": "xpell-3d.package.check",
        "_title": "@xpell/3d package metadata check",
        "_owner": "@xpell/3d",
        "_suite": "xpell-3d.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Verifies package metadata and declared local entries without publishing or network checks.",
        "_profiles": [
          "xpell-3d.package"
        ],
        "_tags": [
          "package-check"
        ],
        "_entry": {
          "_type": "package-check",
          "_check": "package"
        }
      }
    ],
    "_test_profiles": [
      {
        "_id": "xpell-3d.package",
        "_title": "@xpell/3d package verification",
        "_includes": [
          "xpell-3d.*"
        ],
        "_tags": [
          "package",
          "build-only"
        ]
      }
    ]
  },
  "author": "Tamir Fridman <fridman.tamir@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpell-ai/xpell-3d.git"
  },
  "peerDependencies": {
    "three": "^0.182.0",
    "cannon-es": "^0.20.0",
    "three-to-cannon": "^5.0.2",
    "@xpell/core": "^2.0.8",
    "@xpell/ui": "^2.0.8"
  },
  "devDependencies": {
    "@xpell/core": "workspace:*",
    "@xpell/ui": "workspace:*",
    "@types/three": "^0.182.0",
    "cannon-es": "^0.20.0",
    "three": "^0.182.0",
    "three-to-cannon": "^5.0.2",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^3.9.1"
  }
}
